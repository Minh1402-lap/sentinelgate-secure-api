MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=sentinelvault_db
MYSQL_USER=sentinelvault
MYSQL_PASSWORD=replace-with-a-strong-application-password

DATABASE_URL=mysql://sentinelvault:replace-with-a-strong-application-password@127.0.0.1:3307/sentinelvault_db
DOCKER_DATABASE_URL=mysql://sentinelvault:replace-with-a-url-encoded-application-password@database:3306/sentinelvault_db
MIGRATION_DATABASE_URL=mysql://root:replace-with-a-strong-root-password@127.0.0.1:3307/sentinelvault_db
SHADOW_DATABASE_URL=mysql://root:replace-with-a-strong-root-password@127.0.0.1:3307/sentinelvault_shadow
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=sentinelgate
JWT_AUDIENCE=sentinelvault-api
CORS_ORIGINS=http://127.0.0.1:5173
# Optional; omit when Arcjet is not configured.
# ARCJET_KEY=ajkey_replace-with-your-key
HOST=127.0.0.1
PORT=3000
